name: evpn
topology:
  nodes:
    # Leaf
    leaf01:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - configs/daemons:/etc/frr/daemons
        - configs/leaf01.conf:/etc/frr/frr.conf
        - configs/leaf01-start.sh:/start.sh
      exec:
        - bash /start.sh

    leaf02:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - configs/daemons:/etc/frr/daemons
        - configs/leaf02.conf:/etc/frr/frr.conf
        - configs/leaf02-start.sh:/start.sh
      exec:
        - bash /start.sh

    leaf03:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - configs/daemons:/etc/frr/daemons
        - configs/leaf03.conf:/etc/frr/frr.conf
        - configs/leaf03-start.sh:/start.sh
      exec:
        - bash /start.sh
        
# Spine        
    spine01:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - configs/daemons:/etc/frr/daemons
        - configs/spine01.conf:/etc/frr/frr.conf
        
    # Other
    host01:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.1/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:01
        - ip link set dev eth0 down

    host02:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.2/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:02
        - ip link set dev eth0 down

    host03:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.3/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:03
        - ip link set dev eth0 down
        
  links:
    # fabric
    - endpoints: ["leaf01:eth1", "spine01:eth1"]
    - endpoints: ["leaf02:eth1", "spine01:eth2"]
    - endpoints: ["leaf03:eth1", "spine01:eth3"]
      
    # extarnal
    - endpoints: ["host01:eth1", "leaf01:eth2"]      
    - endpoints: ["host02:eth1", "leaf02:eth2"]      
    - endpoints: ["host03:eth1", "leaf03:eth2"]      
