name: l2sw
topology:
  nodes:
    # Leaf
    SW1:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - config_sw/SW1-start.sh:/start.sh
      exec:
        - bash /start.sh

    SW2:
      kind: linux
      image: lab_frr:10.0.0
      binds:
        - config_sw/SW2-start.sh:/start.sh
      exec:
        - bash /start.sh

# Other
    host01:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.1/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:01
        - ip link set dev eth0 down

    host02:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.2/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:02
        - ip link set dev eth0 down

    host03:
      kind: linux
      image: wbitt/network-multitool:latest
      exec:
        - sysctl -w net.ipv6.conf.all.disable_ipv6=1
        - sysctl -w net.ipv6.conf.default.disable_ipv6=1
        - ip addr add 192.168.0.3/24 dev eth1
        - ip link set eth1 address 52:54:00:bb:00:03
        - ip link set dev eth0 down
        
  links:
    # fabric
    - endpoints: ["SW1:eth1", "SW2:eth1"]
      
    # extarnal
    - endpoints: ["SW1:eth2", "host01:eth1"]      
    - endpoints: ["SW1:eth3", "host02:eth1"]      
    - endpoints: ["SW2:eth2", "host03:eth1"]      
